
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Allow public read access to all user images.
    // This allows anyone to view profile pictures in the app.
    match /users/{userId}/images/{allPaths=**} {
      allow read;
      
      // Only the authenticated user can upload or delete their own photos.
      // - The user must be authenticated.
      // - The `userId` in the path must match their own UID.
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
