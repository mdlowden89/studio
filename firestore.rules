rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read any profile, but only write to their own.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == userId;
      // Disallow create/delete to prevent users from creating/deleting other users.
      // User creation is handled server-side during signup.
      allow create, delete: if false;
    }

    // Moments can be created by any authenticated user.
    // They can be read by anyone authenticated.
    // They can only be updated/deleted by the original logger.
    match /moments/{momentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.loggerId;
      // Allow update for confirming a match (updating status and confirmedUserId)
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.loggerId;
    }

    // Notifications can only be read or deleted by the user they are intended for.
    // Creation is handled by server-side logic (actions.ts), so we can be permissive here for authenticated users.
    match /notifications/{notificationId} {
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null;
    }
    
    // Likes can be created by any authenticated user.
    // They can only be read/updated by the user who created the like (likerId).
    match /likes/{likeId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null && request.auth.uid == resource.data.likerId;
      // No one should be able to delete likes for now.
      allow delete: if false;
    }

    // Chat documents and subcollections
    match /chats/{chatId} {
      // Allow read/write access only to participants of the chat
      allow read, update: if request.auth != null && request.auth.uid in resource.data.participantIds;
      // Allow create only if the current user is one of the participants.
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participantIds;

      // Messages subcollection
      match /messages/{messageId} {
        // Allow read only to participants of the parent chat
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        // Allow create only if the sender is the currently authenticated user
        allow create: if request.auth != null && request.auth.uid == request.resource.data.senderId;
        // Do not allow updates or deletes to messages for immutability
        allow update, delete: if false;
      }
    }
  }
}
