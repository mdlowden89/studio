rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read other user profiles, but only write to their own.
    // They can also query the list of users for the discover/swipe page.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }
    match /users/{document=**} {
       allow list: if request.auth != null;
    }

    // Moments can be created by any authenticated user.
    // Users can only read, update, or delete their own moments.
    // Authenticated users can query the moments collection to find matches.
    match /moments/{momentId} {
      allow create: if request.auth != null && request.resource.data.loggerId == request.auth.uid;
      allow read, update, delete: if resource.data.loggerId == request.auth.uid;
    }
    match /moments/{document=**} {
      allow list: if request.auth != null;
    }
    
    // Chats can be created by authenticated users.
    // Users can only read/write to chats they are a participant in.
    // This includes reading the message subcollection.
    match /chats/{chatId} {
      allow read, write: if request.auth.uid in resource.data.participantIds;
      
      match /messages/{messageId} {
        allow read, create: if request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
      }
    }
    match /chats/{document=**} {
        allow list: if request.auth != null;
    }

    // Likes can be created by any authenticated user for another user.
    // Users can read/update likes where they are the liker or the liked user.
    match /likes/{likeId} {
      allow create: if request.auth != null && request.resource.data.likerId == request.auth.uid;
      allow read, update: if request.auth.uid == resource.data.likerId || request.auth.uid == resource.data.likedUserId;
    }
    match /likes/{document=**} {
        allow list: if request.auth != null;
    }
    
    // Notifications can be created server-side (or by trusted client logic).
    // Users can only read notifications intended for them.
    match /notifications/{notificationId} {
      allow create: if request.auth != null;
      allow read, update: if resource.data.userId == request.auth.uid;
    }
    match /notifications/{document=**} {
        allow list: if request.auth != null;
    }
  }
}
