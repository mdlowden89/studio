rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can be read by any authenticated user, but only written to by the user themselves.
    // The `list` permission is crucial for querying the collection (e.g., for swiping).
    match /users/{userId} {
      allow read, list: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }

    // Moments can be created by any authenticated user.
    // They can only be read, updated, or deleted by the user who logged them or the one who confirmed the match.
    match /moments/{momentId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && (request.resource.data.loggerId == request.auth.uid || request.resource.data.confirmedUserId == request.auth.uid);
    }
    
    // Notifications can be read only by the user they are intended for.
    // They can be created by any authenticated user (server-side actions).
    match /notifications/{notificationId} {
        allow create: if request.auth != null;
        allow read, update: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Likes can be created by any authenticated user, as long as they are the liker.
    // They can be read by anyone (for checking match status) and updated by anyone (for match status updates).
    match /likes/{likeId} {
      allow read, update: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.likerId == request.auth.uid;
    }

    // Chats and their sub-collections (messages).
    match /chats/{chatId} {
      // Chat document itself can be read or updated only by participants.
      allow read, update: if request.auth != null && request.auth.uid in resource.data.participantIds;
      // Anyone can create a chat (the action verifies participants).
      allow create: if request.auth != null;

      // Messages within a chat can be read by participants.
      // Messages can only be created by one of the participants.
      match /messages/{messageId} {
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid;
      }
    }
  }
}