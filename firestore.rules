rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users can only update their own profile, but any authenticated user can read profiles.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow update: if request.auth.uid == userId;
    }

    // Moments can be created by the logger.
    // Moments can be read by any authenticated user (for confirmation screens).
    // Moments can be updated by the logger OR the user who is confirming/denying the match.
    match /moments/{momentId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == request.resource.data.loggerId;
      // Allow update if the user is the one who logged it, or the one being asked to confirm.
      // A user might need to update a moment they logged (e.g., replay it).
      // A user might need to update a moment to confirm it (becoming the confirmedUserId).
      allow update: if request.auth.uid == resource.data.loggerId || request.auth.uid == request.resource.data.confirmedUserId;
    }

    // Any authenticated user can create a like.
    // A user can read/update a like if they are the liker OR the one being liked.
    match /likes/{likeId} {
        allow create: if request.auth.uid == request.resource.data.likerId;
        allow read, update: if request.auth.uid == resource.data.likerId || request.auth.uid == resource.data.likedUserId;
    }

    // Chats can be read/written to only by participants.
    // This includes reading the chat document itself (for chat lists) and messages.
    match /chats/{chatId} {
      allow read, update, create: if request.auth.uid in resource.data.participantIds;

      // Messages can be read by chat participants and created by the sender.
      match /messages/{messageId} {
        allow read: if request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        allow create: if request.auth.uid == request.resource.data.senderId && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
      }
    }

    // Notifications can be created by any authenticated user (e.g., system or other users).
    // A user can only read/update their own notifications.
    match /notifications/{notificationId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth.uid == resource.data.userId;
    }
  }
}
