rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isParticipant(chatId) {
      return request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
    }

    // Users collection
    match /users/{userId} {
      // Anyone can read a user's profile
      allow read: if isSignedIn();
      // Only the owner can create or update their own profile
      allow create, update: if isOwner(userId);
    }

    // Moments collection
    match /moments/{momentId} {
        // Only the logger or the confirmed user can read a moment
        allow read: if isSignedIn() && (isOwner(resource.data.loggerId) || (resource.data.confirmedUserId != null && isOwner(resource.data.confirmedUserId)));
        // Only signed-in users can create moments
        allow create: if isSignedIn();
        // Only the owner can update their own moment (e.g. to replay it)
        // or a confirmed user can update it (to confirm the match)
        allow update: if isSignedIn() && (isOwner(resource.data.loggerId) || (request.resource.data.confirmedUserId != null && isOwner(request.resource.data.confirmedUserId)));
    }
    
    // Likes collection
    match /likes/{likeId} {
        // Anyone can read likes to check for matches (could be tightened later)
        allow read: if isSignedIn();
        // Users can only create likes where they are the liker
        allow create: if isSignedIn() && isOwner(request.resource.data.likerId);
        // A user can update a like if they are the original liker OR if they are the one being liked (to complete the match)
        allow update: if isSignedIn() && (isOwner(resource.data.likerId) || isOwner(resource.data.likedUserId));
    }

    // Chats collection
    match /chats/{chatId} {
      // Only participants can read a chat document
      allow read: if isParticipant(chatId);
      // Participants can be created by the system (server-side action)
      allow create: if isSignedIn(); // Let's allow any signed in user to create a chat for now
      // Only participants can update chat (e.g. lastMessage)
      allow update: if isParticipant(chatId);

      // Messages subcollection
      match /messages/{messageId} {
        // Only participants can read messages
        allow list, read: if isParticipant(chatId);
        // Only participants can send messages
        allow create: if isParticipant(chatId) && isOwner(request.resource.data.senderId);
      }
    }
    
    // Notifications collection
    match /notifications/{notificationId} {
        // Users can only read their own notifications
        allow read, list: if isOwner(resource.data.userId);
        // Notifications are created by server actions, but for simplicity we'll allow any signed-in user to create them for now
        allow create: if isSignedIn();
        // Users can mark their own notifications as read
        allow update: if isOwner(resource.data.userId);
    }
  }
}
