
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Rules for user profiles
    match /users/{userId} {
      // Any authenticated user can read user profiles (for swiping, viewing matches, etc.)
      allow read: if request.auth != null;
      // A user can only write to their own profile
      allow write: if request.auth.uid == userId;
    }
    
    // Moments can be created by any logged in user
    match /moments/{momentId} {
      allow create: if request.auth != null;
      // Any authenticated user can confirm/deny a moment (simplification for matching)
      allow update: if request.auth != null;
      // Users can read moments to confirm them
      allow read: if request.auth != null;
    }

    // Likes can be created by any logged in user
    match /likes/{likeId} {
      allow create: if request.auth != null;
      // A user can read/update a like they sent or one they received.
      allow read, update, delete: if request.auth != null && (request.auth.uid == resource.data.likerId || request.auth.uid == resource.data.likedUserId);
    }
    
    // Chat and message rules
    match /chats/{chatId} {
      // Users can only access chats they are a part of.
      allow read, write: if request.auth.uid in resource.data.participantIds;
      
      // Messages can only be accessed by chat participants.
      match /messages/{messageId} {
        allow read, create: if request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
      }
    }

    // Notification rules
    match /notifications/{notificationId} {
      // Server actions (trusted) can create notifications.
      allow create: if request.auth != null; 
      // Users can only read or update their own notifications (e.g., mark as read).
      allow read, write: if request.auth.uid == resource.data.userId;
    }
  }
}
