rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId && 
                       request.resource.data.keys().hasAll([
                         'id', 'name', 'email', 'age', 'bio', 'images', 
                         'vibeTags', 'prompts', 'locationPatterns', 
                         'achievements', 'challenges', 'locationServicesEnabled', 
                         'onboardingComplete', 'work', 'jobTitle', 'education',
                         'ethnicity', 'gender', 'childrenStatus', 'familyPlans',
                         'height', 'heightInches', 'locationAddress', 'locationName',
                         'locationCoordinates', 'drinking', 'smoking', 'zodiacSign',
                         'datingIntentions', 'religion', 'relationshipType',
                         'interestedIn', 'isVerified', 'subscription', 'glowEffect',
                         'mbtiType', 'idealMbtiType', 'mbtiQuizProgress', 'showMbtiOnProfile'
                       ]);
    }
    match /moments/{momentId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == request.resource.data.loggerId;
      allow update: if request.auth != null; // Allow any logged-in user to update (e.g., for confirming a match)
    }
    match /chats/{chatId} {
      allow read, write: if request.auth.uid in resource.data.participantIds;
      match /messages/{messageId} {
        allow read, create: if request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
      }
    }
    match /notifications/{notificationId} {
      allow read: if request.auth.uid == resource.data.userId;
      allow create: if request.auth != null;
    }
     match /likes/{likeId} {
      allow read, create: if request.auth != null;
      allow update: if request.auth != null && 
                       get(/databases/$(database)/documents/likes/$(likeId)).data.likedUserId == request.auth.uid;
    }
  }
}
