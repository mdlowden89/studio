
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read public profiles, but only write to their own.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }

    // Moments can be created by any authenticated user.
    // They can be read/updated by the logger or confirmed user.
    // list allows the server action to query for matches.
    match /moments/{momentId} {
      allow create: if request.auth != null && request.resource.data.loggerId == request.auth.uid;
      allow read, update: if request.auth != null && (request.auth.uid == resource.data.loggerId || request.auth.uid == resource.data.confirmedUserId);
      allow list: if request.auth != null;
    }

    // Likes can be created by authenticated users.
    // They can be read/updated by either the liker or the liked user.
    // list allows server actions to query for matches.
    match /likes/{likeId} {
      allow create: if request.auth != null && request.resource.data.likerId == request.auth.uid;
      allow read, update: if request.auth != null && (request.auth.uid == resource.data.likerId || request.auth.uid == resource.data.likedUserId);
      allow list: if request.auth != null;
    }

    // Chat documents can be read/updated if the user is a participant.
    match /chats/{chatId} {
      allow read, update, create: if request.auth != null && request.auth.uid in resource.data.participantIds;

      // Messages can be read by participants, and created by the sender.
      match /messages/{messageId} {
        allow read: if request.auth != null && get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds.hasAny([request.auth.uid]);
        allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid && get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds.hasAny([request.auth.uid]);
      }
    }

    // Notifications can be read/updated by the user they are intended for.
    // They can be created by any authenticated user (e.g., via a server action).
    match /notifications/{notificationId} {
      allow read, update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null;
    }
  }
}
