
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // By default, deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // USERS
    // Anyone can read a user's profile for browsing.
    // Only the authenticated user can create or update their own profile.
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth.uid == userId;
    }

    // LIKES
    // Any authenticated user can create, read, and update likes.
    // This is needed for the logic that creates likes and checks for matches.
    match /likes/{likeId} {
      allow read, update, create: if request.auth != null;
    }

    // MOMENTS
    // Authenticated users can create moments.
    // They can read any moment (for confirmation flows) and update moments they are involved in.
    match /moments/{momentId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update: if request.auth.uid == resource.data.loggerId || request.auth.uid == request.resource.data.confirmedUserId;
    }
    
    // NOTIFICATIONS
    // Users can only read or update their own notifications.
    // Notifications are created by trusted server actions.
    match /notifications/{notificationId} {
      allow read, update: if request.auth.uid == resource.data.userId;
      allow create: if request.auth != null;
    }

    // CHATS
    // Users can only read, create, or update chats they are a part of.
    match /chats/{chatId} {
      allow read, create, update: if request.auth.uid in resource.data.participantIds;
      
      // MESSAGES (subcollection of chats)
      // The same rule applies: you can only read or create messages in a chat you belong to.
      match /messages/{messageId} {
        allow read, create: if request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
      }
    }
  }
}

    