
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the user is the owner of a document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // USERS
    // Users can read their own profile.
    // Users can create their own profile upon signup.
    // Users can only update their own profile.
    // No one can delete a user profile through the client.
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // MOMENTS
    // Users can create (log) their own moments.
    // Users can read moments they are involved in (either logger or confirmed user).
    // Users can update moments (e.g., to confirm) if they are the confirmedUserId.
    match /moments/{momentId} {
      allow create: if isAuthenticated() && isOwner(request.resource.data.loggerId);
      allow read: if isAuthenticated() && (resource.data.loggerId == request.auth.uid || resource.data.confirmedUserId == request.auth.uid);
      allow update: if isAuthenticated() && (isOwner(resource.data.loggerId) || isOwner(request.resource.data.confirmedUserId));
      allow delete: if false; // Protect moments from being deleted by clients
    }
    
    // NOTIFICATIONS
    // Users can read notifications intended for them.
    // Notifications are created server-side (allow write: if false for clients).
    match /notifications/{notificationId} {
      allow read, update: if isAuthenticated() && isOwner(resource.data.userId);
      allow create, delete: if false; // Created by server, managed by TTL or server logic
    }
    
    // CHATS
    // Users can read and write to chats they are a participant in.
    match /chats/{chatId} {
      allow read, update: if isAuthenticated() && request.auth.uid in resource.data.participantIds;
      // Chat creation is handled by server action after a match is confirmed
      allow create: if isAuthenticated();
      allow delete: if false;

      // MESSAGES (sub-collection of chats)
      // Users can read messages in chats they are part of.
      // Users can only create messages as themselves.
      match /messages/{messageId} {
        allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        allow create: if isAuthenticated() && isOwner(request.resource.data.senderId);
        allow update, delete: if false;
      }
    }
  }
}
