rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users can read any profile, but only write to their own.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth.uid == userId;
      allow delete: if false;
    }

    // Moments can be created by any authenticated user.
    // More complex read/update logic is handled in server actions.
    match /moments/{momentId} {
      allow read, write: if request.auth != null;
    }

    // Users can only read/write to chats they are a part of.
    match /chats/{chatId} {
      allow read, write: if request.auth.uid in resource.data.participantIds;
    }

    // Messages can only be read/created by participants of the chat.
    match /chats/{chatId}/messages/{messageId} {
       allow read, create: if request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
       allow update, delete: if false;
    }
    
    // Notifications can only be read by the intended user.
    // They are created by server-side actions.
    match /notifications/{notificationId} {
      allow read: if resource.data.userId == request.auth.uid;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
    
    // Likes can be created/updated by any authenticated user.
    match /likes/{likeId} {
      allow read, write: if request.auth != null;
    }
  }
}
